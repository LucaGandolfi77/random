{
  "type": "module",
  "name": "caffe-sospeso",
  "version": "1.0.0",
  "private": true,
  "description": "Cozy game PWA per un caff\u00e8 di quartiere, bilingue IT/EN, funzionante offline.",
  "scripts": {
    "start": "npx serve . || python3 -m http.server 8000",
    "dev": "npx serve .",
    "check": "node tools/check-syntax.mjs && node tools/smoke-import.mjs",
    "lint": "npx eslint 'js/**/*.js' --max-warnings 0 || true",
    "format": "npx prettier --write 'js/**/*.js' 'index.html' 'README.md'"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
