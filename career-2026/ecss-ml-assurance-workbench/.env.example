# ECSS ML Assurance Workbench — week 1 (Data Readiness Inspector)
# Copy to .env and adjust if needed. docker compose reads .env automatically.

# Comma separated list of allowed browser origins for the API (dev defaults).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Maximum accepted upload size in MB.
MAX_UPLOAD_SIZE_MB=50

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=production

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=8080
