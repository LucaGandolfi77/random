{
  "info": {
    "name": "ECSS ML Assurance Workbench API",
    "description": "Full API collection for the ECSS ML Assurance Workbench backend.\n\nBase URL: http://localhost:8000\n\nFeatures:\n- Data Readiness Inspector\n- Portfolio Management\n- Assurance Engine\n- Continuous Assurance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "packageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health",
            "description": "Full health check with database status"
          }
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health/live",
            "description": "Simple liveness check"
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health/ready",
            "description": "Readiness check with dependency status"
          }
        },
        {
          "name": "Version Info",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/version",
            "description": "Tool and analyzer version"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects",
            "description": "Get all projects"
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/projects",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My ML Project\",\n  \"description\": \"A sample ML project for testing\"\n}"
            },
            "description": "Create a new project"
          }
        },
        {
          "name": "Get Project",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "description": "Get project by ID"
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Project Name\"\n}"
            },
            "description": "Update project fields"
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "description": "Delete project and associated data"
          }
        }
      ]
    },
    {
      "name": "Datasets",
      "item": [
        {
          "name": "Upload Dataset",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/datasets",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/your/dataset.csv"
                }
              ]
            },
            "description": "Upload CSV dataset (max 50MB)"
          }
        },
        {
          "name": "Get Current Dataset",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/dataset",
            "description": "Get active dataset metadata"
          }
        },
        {
          "name": "Get Dataset Preview",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/dataset/preview?limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "dataset", "preview"],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Number of rows (1-500)"
                }
              ]
            },
            "description": "Preview dataset (max 500 rows)"
          }
        },
        {
          "name": "Delete Dataset",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/dataset",
            "description": "Delete current dataset"
          }
        }
      ]
    },
    {
      "name": "Analysis Config",
      "item": [
        {
          "name": "Get Config",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/config",
            "description": "Get analysis configuration"
          }
        },
        {
          "name": "Update Config",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/config",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_column\": \"target\",\n  \"timestamp_column\": \"timestamp\",\n  \"id_column\": \"id\"\n}"
            },
            "description": "Update analysis configuration"
          }
        }
      ]
    },
    {
      "name": "Analysis",
      "item": [
        {
          "name": "Run Analysis",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/analysis",
            "description": "Execute data readiness analysis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.run_id) {",
                  "    pm.collectionVariables.set('runId', jsonData.run_id);",
                  "    console.log('Run ID saved: ' + jsonData.run_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Latest Analysis",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/analysis/latest",
            "description": "Get latest analysis run"
          }
        },
        {
          "name": "Get Analysis by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/analysis/{{runId}}",
            "description": "Get analysis run details"
          }
        },
        {
          "name": "Get Analysis Score",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/analysis/{{runId}}/score",
            "description": "Get data readiness score"
          }
        },
        {
          "name": "List Findings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/analysis/{{runId}}/findings?status=FAIL&severity=HIGH&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "{{runId}}", "findings"],
              "query": [
                {
                  "key": "status",
                  "value": "FAIL",
                  "description": "PASS|WARNING|FAIL|NOT_APPLICABLE|NOT_EVALUATED"
                },
                {
                  "key": "severity",
                  "value": "HIGH",
                  "description": "CRITICAL|HIGH|MEDIUM|LOW|INFO"
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Max results"
                }
              ]
            },
            "description": "List findings with filters"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Generate Report",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/analysis/{{runId}}/report",
            "description": "Generate JSON report from analysis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('reportId', jsonData.id);",
                  "    console.log('Report ID saved: ' + jsonData.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Project Reports",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/reports",
            "description": "List all reports for project"
          }
        },
        {
          "name": "Get Report Content",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/reports/{{reportId}}",
            "description": "Get report JSON content"
          }
        },
        {
          "name": "Download Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/reports/{{reportId}}/download",
            "description": "Download report as JSON file"
          }
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "Get Global Audit Log",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/audit?limit=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit"],
              "query": [
                {
                  "key": "limit",
                  "value": "200",
                  "description": "Max events (1-1000)"
                }
              ]
            },
            "description": "Get global audit events"
          }
        },
        {
          "name": "Get Project Audit Log",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/audit",
            "description": "Get audit events for project"
          }
        }
      ]
    },
    {
      "name": "Portfolio",
