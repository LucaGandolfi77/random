    {
      "name": "Continuous Assurance",
      "item": [
        {
          "name": "Ingest CI Results",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/ingest",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/test-results.xml"
                },
                {
                  "key": "source_type",
                  "value": "junit_xml",
                  "type": "text"
                }
              ]
            },
            "description": "Ingest JUnit XML or JSON test results"
          }
        },
        {
          "name": "Create Snapshot",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/snapshots",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Pre-release snapshot\",\n  \"role\": \"Release Candidate\",\n  \"created_by\": \"user\"\n}"
            },
            "description": "Create immutable assurance snapshot"
          }
        },
        {
          "name": "List Snapshots",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/snapshots",
            "description": "List all snapshots for project"
          }
        },
        {
          "name": "Compare Snapshots",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/continuous/snapshots/compare",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseline_a\": \"snapshot-id-1\",\n  \"baseline_b\": \"snapshot-id-2\"\n}"
            },
            "description": "Compare two snapshots"
          }
        },
        {
          "name": "Detect Regressions",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/regressions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseline_a\": \"snapshot-id-1\",\n  \"baseline_b\": \"snapshot-id-2\"\n}"
            },
            "description": "Detect regressions between snapshots"
          }
        },
        {
          "name": "List Regressions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/regressions",
            "description": "List all regressions for project"
          }
        },
        {
          "name": "List Action Items",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/actions",
            "description": "List all action items"
          }
        },
        {
          "name": "Export Actions CSV",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/actions/export",
            "description": "Export actions as CSV"
          }
        },
        {
          "name": "Close Action Item",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/continuous/actions/{{actionId}}/close",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution\": \"Fixed in commit abc123\",\n  \"closing_evidence\": \"link-to-proof\"\n}"
            },
            "description": "Close an action item"
          }
        },
        {
          "name": "Generate Issue Draft",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/continuous/actions/{{actionId}}/issue-draft",
            "description": "Generate GitHub issue draft"
          }
        },
        {
          "name": "Create Reproducibility Record",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/reproducibility",
            "description": "Generate reproducibility record"
          }
        },
        {
          "name": "Generate Review Pack",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/continuous/projects/{{projectId}}/review-pack",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_type\": \"Portfolio Demonstration Review\"\n}"
            },
            "description": "Generate Technical Review Pack ZIP"
          }
        }
      ]
    }
  ]
}
