      "item": [
        {
          "name": "Analyze Gaps",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/assurance-engine/projects/{{projectId}}/gaps",
            "description": "Run gap analysis (26 rules)"
          }
        },
        {
          "name": "Get Traceability Issues",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/assurance-engine/projects/{{projectId}}/traceability-issues",
            "description": "Check traceability orphans"
          }
        },
        {
          "name": "Get Assurance Dimensions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/assurance-engine/projects/{{projectId}}/dimensions",
