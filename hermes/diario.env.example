# diario.env — configurazione del bridge bot Telegram -> Profeta in Delirio
# Copia questo file come "diario.env" e riempi i valori.
# NON committare diario.env (è già nel .gitignore).

# 1. Token del tuo bot Telegram (crealo con @BotFather su Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# 2. Il TUO chat ID Telegram (solo tu puoi usare il bot)
#    Scoprilo scrivendo a @userinfobot su Telegram, oppure:
#    avvia il bot temporary con: python3 -c "..." (vedi README)
#    Oppure manda un messaggio al tuo bot e guarda i logs.
TELEGRAM_CHAT_ID=123456789

# 3. Cartella hermes (di solito dove si trova questo file)
HERMES_DIR=/Users/tuo_utente/random/hermes

# 4. API key OpenRouter (per il modello LLM gratuito)
#    Registrati su https://openrouter.ai e crea una key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. File di log del bot (opzionale)
DIARIO_LOG=/Users/tuo_utente/random/hermes/runtime/logs/bot.log