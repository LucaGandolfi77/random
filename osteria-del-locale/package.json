{
  "name": "osteria-del-locale",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "spike": "vite --open /spike/bench.html",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run && npm run playtest",
    "playtest": "node tools/playtest.mjs",
    "dev:game": "vite",
    "smoke": "node tools/smoke.mjs",
    "icons": "node tools/gen-icons.mjs",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke && npm run demo",
    "demo": "node tools/demo.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "description": "An absurd-comedy tavern game whose narrator runs entirely on-device. The engine decides; the model only describes."
}
