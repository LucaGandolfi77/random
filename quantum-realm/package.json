{
  "name": "qbit",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "playtest": "node scripts/playtest.mjs",
    "test": "npm run typecheck && npm run lint && npm run playtest && node scripts/controls.mjs",
    "controls": "npm run build && node scripts/controls.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "A hand-made puzzle-platformer set inside a quantum computer, where you learn superposition, tunnelling, entanglement and uncertainty by playing with them."
}
