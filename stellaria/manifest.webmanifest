{
  "name": "Stellaria — La Piazza dei Riflessi",
  "short_name": "Stellaria",
  "description": "Un gioco cozy mobile PWA dove la fama è la moneta e il riflesso è la verità. Esplora una piazza, esibisciti, arreda e scopri cosa conta davvero.",
  "lang": "it",
  "dir": "ltr",
  "scope": ".",
  "start_url": ".",
  "id": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "theme_color": "#1a1530",
  "background_color": "#1a1530",
  "categories": ["game", "entertainment", "casual", "personalization", "social"],
  "prefer_related_applications": false,
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "text": "text" }
  },
  "shortcuts": [
    { "name": "Gioca", "short_name": "Play", "description": "Continua la partita", "url": "./?action=play", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inventario", "short_name": "Items", "description": "Il tuo inventario", "url": "./?action=inventory", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Traguardi", "short_name": "Awards", "description": "I tuoi traguardi", "url": "./?action=achievements", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "./icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" },
    { "src": "./icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml" },
    { "src": "./icons/maskable-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/apple-touch-icon-180.png", "sizes": "180x180", "type": "image/png" }
  ]
}
