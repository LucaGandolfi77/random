{
  "name": "tailssh-pwa",
  "version": "1.0.0",
  "description": "Installable iPhone PWA that SSHes into Mac/Linux machines over Tailscale, via a tiny WebSocket->SSH relay on your tailnet.",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "vendor": "node scripts/vendor.js",
    "icons": "python3 scripts/make_icons.py"
  },
  "dependencies": {
    "ssh2": "^1.16.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@novnc/novnc": "^1.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "pako": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
